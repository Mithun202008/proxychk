# ---------- Parse Version Tuple for Semantic Versioning ----------
def parse_version_tuple(v_str):
    if not v_str:
        return (0, 0, 0)
    cleaned = v_str.strip().lstrip('vV')
    parts = [int(x) for x in re.findall(r'\d+', cleaned)]
    return tuple(parts) if parts else (0, 0, 0)

