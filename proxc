            print(f"  {GREEN}  │{RESET}")
            print(f"  {GREEN}  │{RESET}  {BOLD}Proxy String   :{RESET}  {DIM}--proxy {parsed['proto']}://{auth_str}{parsed['ip']}:{parsed['port']}{RESET}")
            print(f"  {GREEN}{BOLD}  └──────────────────────────────────────────────────────────────{RESET}\n")
            sys.exit(0)
